# ============================================================
#  CivicAssist — environment template
#  Copy this file to backend/.env and fill in your values.
#      cp .env.example backend/.env
#  These values override config/config.yaml at runtime.
# ============================================================

# ---------- LLM Configuration ----------
# Leave LLM_API_KEY empty to run WITHOUT an LLM.
# The chat will still retrieve sources but reply "No LLM connected".
#
# Providers (uncomment the block you want):
#
#   Anthropic (Claude)   — uses the native /v1/messages API automatically
#     LLM_API_ENDPOINT=https://api.anthropic.com
#     LLM_MODEL_NAME=claude-sonnet-4-5
#
#   OpenAI
#     LLM_API_ENDPOINT=https://api.openai.com
#     LLM_CHAT_ENDPOINT=/v1/chat/completions
#     LLM_MODEL_NAME=gpt-4o-mini
#
#   Ollama (local, no API key required)
#     LLM_API_ENDPOINT=http://localhost:11434
#     LLM_CHAT_ENDPOINT=/v1/chat/completions
#     LLM_MODEL_NAME=llama3

LLM_API_KEY=your_api_key_here
LLM_API_ENDPOINT=https://api.anthropic.com
LLM_MODEL_NAME=claude-sonnet-4-5
# LLM_CHAT_ENDPOINT=/v1/chat/completions
# LLM_EMBEDDING_ENDPOINT=/v1/embeddings

# ---------- Admin panel (overrides config.yaml) ----------
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin

# ---------- Misc ----------
CONFIG_PATH=./config/config.yaml
LOG_LEVEL=INFO
